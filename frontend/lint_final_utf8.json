const login = (userData: User) => {\n        setUser(userData)\n    }\n\n    const isAuthenticated = user !== null\n\n    return (\n        <AuthContext.Provider value={{ user, setUser, login, isAuthenticated }}>\n            {children}\n        </AuthContext.Provider>\n    )\n}\n\nexport const useAuth = () => {\n    const context = useContext(AuthContext)\n    if (context === undefined) {\n        throw new Error('useAuth must be used within an AuthProvider')\n    }\n    return context\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Development\\Projects\\Project HealthGuardAI\\HealthguardAI\\frontend\\src\\lib\\healthAI.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Development\\Projects\\Project HealthGuardAI\\HealthguardAI\\frontend\\src\\main.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Development\\Projects\\Project HealthGuardAI\\HealthguardAI\\frontend\\src\\pages\\BillAnalysis.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Development\\Projects\\Project HealthGuardAI\\HealthguardAI\\frontend\\src\\pages\\DoctorDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Development\\Projects\\Project HealthGuardAI\\HealthguardAI\\frontend\\src\\pages\\DoctorFinder.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Development\\Projects\\Project HealthGuardAI\\HealthguardAI\\frontend\\src\\pa